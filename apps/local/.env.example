# Ixtiyoriy. Kalitlarni dastur ichida (⚙ Sozlamalar) kiritish osonroq —
# bu fayl faqat kalitlarni fayl orqali berishni xohlaganlar uchun.
# Nusxa oling: .env.example -> .env

# ANTHROPIC_API_KEY=sk-ant-...
# ELEVENLABS_API_KEY=sk_...

# Yozuvlar saqlanadigan papka (standart: uy papkangizdagi "Suhbat-AI")
# SUHBAT_DATA_DIR=D:\Suhbatlar

# Port (standart 4780)
# SUHBAT_PORT=4780
