# Nusxa oling:  cp .env.example .env   — so'ng qiymatlarni to'ldiring.

# Sayt manzili (DNS'da A-yozuvi shu serverning IP manziliga qaratilgan bo'lishi kerak)
SUHBAT_DOMAIN=suhbat.firma.uz

# Jamoa paroli (kamida 10 belgi). Hamma xodimlar shu parol bilan kiradi.
SUHBAT_PASSWORD=

# Kalitlarni bu yerga yoki sayt ichidagi ⚙ Sozlamalar'ga yozish mumkin (bu yerdagisi ustun turadi).
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
