{
  "name": "@suhbat/recording-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privileged Phase 4 recording write path. Private service; reachable only from the Web gateway.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@suhbat/contracts": "0.1.0",
    "@suhbat/database": "0.1.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts"
    },
    "./authorization": {
      "types": "./src/authorization.ts",
      "import": "./src/authorization.ts"
    }
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
