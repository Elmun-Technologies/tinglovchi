<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for the microphone TCC prompt. ScreenCaptureKit system-audio capture is gated by the
       Screen Recording permission, which has no Info.plist key; it is requested through
       CGRequestScreenCaptureAccess() in the native bridge. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>SUHBAT records your microphone so meeting audio can be saved on this Mac.</string>
  <!-- Outbound HTTPS only, and never a downgrade: App Transport Security stays on so a plain-HTTP
       API origin cannot be used even if the build variable is edited. Loopback is the one exception,
       for local development against http://localhost:3000. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <false/>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
</dict>
</plist>
