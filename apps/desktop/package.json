{
  "name": "@suhbat/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first macOS recorder (Tauri 2 + React). Capture and persistence are Rust; this package is the renderer only.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "tauri": "tauri",
    "cargo:test": "cargo test --workspace --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@suhbat/contracts": "0.1.0",
    "@suhbat/shared": "0.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "vite": "8.3.3"
  }
}
