# Copy to apps/web/.env.local for local web development or inject into isolated production services.
# NEVER commit populated .env files or real secrets.
# NEXT_PUBLIC_* values are embedded in browser bundles and MUST contain public values only.

# ==============================================================================
# 1. Supabase
# ==============================================================================
# Public browser/SSR Supabase credentials (anon key only; enforced by PostgreSQL RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Worker-only / migration-only credentials. NEVER expose in NEXT_PUBLIC_* or browser bundles.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ==============================================================================
# 2. Storage/R2
# ==============================================================================
# Allowed values: 'local' | 'memory' (development/test only) | 'r2' (mandatory in production).
STORAGE_PROVIDER=local
LOCAL_OBJECT_STORAGE_ROOT=.local/object-storage
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# ==============================================================================
# 3. Transcription
# ==============================================================================
# Allowed values: 'fake' (development/test only) | 'assemblyai' (mandatory in production).
TRANSCRIPTION_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
ASSEMBLYAI_MODEL=universal-2
ASSEMBLYAI_TRANSCRIPTION_MODEL=universal-2

# ==============================================================================
# 4. AI provider
# ==============================================================================
# Allowed values: 'fake' (development/test only) | 'openai' (mandatory in production).
SUHBAT_INTELLIGENCE_PROVIDER=openai
SUHBAT_EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_INTELLIGENCE_MODEL=gpt-4.1-mini
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=64

# ==============================================================================
# 5. Telegram
# ==============================================================================
# Allowed values: 'fake' (development/test only) | 'telegram' (when Telegram companion is enabled).
SUHBAT_TELEGRAM_PROVIDER=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE_URL=https://api.telegram.org

# ==============================================================================
# 6. Deployment
# ==============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=SUHBAT AI
# Canonical origin for email confirmation, callback redirects, and deep links.
# Production and staging require an explicit HTTPS origin (e.g., https://app.suhbat.uz).
APP_URL=http://localhost:3000
# Data mode: 'demo' (fixture-backed demo UI) | 'live' (PostgreSQL/API-backed production runtime).
SUHBAT_DATA_MODE=demo

# Durable worker & business automation runtime configuration
WORKER_ID=suhbat-worker-01
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
PROCESSING_MAX_ATTEMPTS=5
PROCESSING_LEASE_SECONDS=300
SUHBAT_AUTOMATION_PROVIDER=webhook
AUTOMATION_WEBHOOK_SECRET=
AUTOMATION_DEFAULT_WEBHOOK_URL=

# ==============================================================================
# 7. Observability
# ==============================================================================
LOG_LEVEL=info
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
