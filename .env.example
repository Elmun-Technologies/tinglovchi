# NEXT_PUBLIC_* values are embedded in browser bundles and MUST contain public values only.
#
# ==============================================================================
# THREE ROLES — copy a different subset for each deployment
# ==============================================================================
#
# SUHBAT ships as three separate services. They do not share a process and they do not share a
# credential. See docs/deployment-topology.md.
#
#   ROLE           | SUHBAT_RUNTIME_ROLE | Has SUPABASE_DB_URL | Has provider keys | Public
#   ---------------|---------------------|---------------------|-------------------|-------
#   Web            | web                 | NO (forbidden)      | no                | yes
#   Recording API  | recording-api       | YES                 | NO (forbidden)    | no
#   Worker         | worker              | YES                 | yes               | no
#
# Legend for the markers below:
#   [web]            required by the Web deployment only
#   [recording-api]  required by the Recording API only
#   [worker]         required by the Worker only
#   [all]            required by every deployment
#   (unmarked)       set it on whichever deployment the section describes
#

# ==============================================================================
# 1. Supabase
# ==============================================================================
# [web] Public browser/SSR Supabase credentials (anon key only; enforced by PostgreSQL RLS).
# These are the ONLY Supabase credentials the web deployment holds.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [recording-api] [worker] PRIVILEGED. Forbidden in the Web deployment and in any NEXT_PUBLIC_* key.
# These bypass row-level security; only the two private services may hold them.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ==============================================================================
# 1b. Service-to-service authentication  [web] [recording-api]
# ==============================================================================
# The Web gateway signs every request it forwards to the Recording API with this secret, and the
# Recording API refuses anything that is not correctly signed. Neither service is reachable without
# it, and the desktop never sees it.
#
# Generate with: openssl rand -hex 32
#
# Rotate without downtime by listing the new key first, deploying everywhere, then removing the old:
#   SUHBAT_INTERNAL_API_SECRETS=next:<new>,primary:<old>
SUHBAT_INTERNAL_API_SECRET=

# [web] Where the Recording API is reachable. MUST be a private-network host in production
# (.internal or .flycast on Fly, loopback for local development). The Recording API is never public.
SUHBAT_RECORDING_API_URL=http://127.0.0.1:8080

# [recording-api] Port and bind address. Bind all interfaces so Fly's health check can reach it;
# the service is protected by private networking, not by the bind address.
PORT=8080
HOST=0.0.0.0

# ==============================================================================
# 2. Storage/R2   [recording-api] [worker]
# ==============================================================================
# The web deployment does NOT need these: it never signs an object URL. The Recording API does.
# Allowed values: 'local' | 'memory' (development/test only) | 'r2' (mandatory in production).
STORAGE_PROVIDER=local
LOCAL_OBJECT_STORAGE_ROOT=.local/object-storage
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# ==============================================================================
# 3. Transcription   [worker]
# ==============================================================================
# FORBIDDEN on the recording-api deployment: it performs no processing, and validation will reject
# a recording-api environment that carries ASSEMBLYAI_API_KEY.
# Allowed values: 'fake' (development/test only) | 'assemblyai' (mandatory in production).
TRANSCRIPTION_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
ASSEMBLYAI_MODEL=universal-2
ASSEMBLYAI_TRANSCRIPTION_MODEL=universal-2

# ==============================================================================
# 4. AI provider   [worker]
# ==============================================================================
# FORBIDDEN on the recording-api and web deployments. Validated at boot.
# Allowed values: 'fake' (development/test only) | 'openai' (mandatory in production).
SUHBAT_INTELLIGENCE_PROVIDER=openai
SUHBAT_EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_INTELLIGENCE_MODEL=gpt-4.1-mini
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=64

# ==============================================================================
# 5. Telegram   [worker]
# ==============================================================================
# Allowed values: 'fake' (development/test only) | 'telegram' (when Telegram companion is enabled).
SUHBAT_TELEGRAM_PROVIDER=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE_URL=https://api.telegram.org

# ==============================================================================
# 6. Deployment   [all]
# ==============================================================================
# Declares which of the three roles this process is. Validation refuses to start when it disagrees
# with the role being audited, and the privileged executor refuses to connect when it says "web".
SUHBAT_RUNTIME_ROLE=web
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=SUHBAT AI
# Canonical origin for email confirmation, callback redirects, and deep links.
# Production and staging require an explicit HTTPS origin (e.g., https://app.suhbat.uz).
APP_URL=http://localhost:3000
# Data mode: 'demo' (fixture-backed demo UI) | 'live' (reads through the signed-in Supabase session).
# 'live' requires NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY; without them every dashboard
# read fails with an explicit not_configured error rather than falling back to fixtures.
SUHBAT_DATA_MODE=demo

# [worker] Durable worker & business automation runtime configuration
WORKER_ID=suhbat-worker-01
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
PROCESSING_MAX_ATTEMPTS=5
PROCESSING_LEASE_SECONDS=300
SUHBAT_AUTOMATION_PROVIDER=webhook
AUTOMATION_WEBHOOK_SECRET=
AUTOMATION_DEFAULT_WEBHOOK_URL=

# ==============================================================================
# 7. Desktop recorder (one-tap)
# ==============================================================================
# The only variable the desktop renderer is allowed to read (see
# tests/desktop/cloud-boundary.test.ts). It is baked in at build time by Vite and names the origin of
# the SUHBAT API — nothing else. There is no provider credential, storage secret, or Supabase key
# anywhere in the desktop app; the recorder authenticates with a long-lived server-issued session
# token it obtains through the browser connect-code flow.
#
# Production and staging MUST be an explicit HTTPS origin. Plain HTTP is accepted only for loopback
# (`http://localhost:3000`, `http://127.0.0.1:3000`) so the desktop can talk to a local dev server.
# Left empty, the recorder runs signed-out and refuses to upload rather than guessing a host.
#
# This is the desktop's ONLY origin. It points at the public Web app, never at the Recording API —
# the Web gateway forwards recording requests over the private network on the desktop's behalf, so
# the desktop binary never needs to know an internal hostname.
VITE_SUHBAT_API_BASE_URL=http://localhost:3000

# ==============================================================================
# 8. Observability
# ==============================================================================
LOG_LEVEL=info
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
