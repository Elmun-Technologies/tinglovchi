# Copy to apps/web/.env.local for local Phase 1 web development. Never commit populated local env files.
# NEXT_PUBLIC_* values are embedded in browser bundles and MUST contain public values only.
# Keep future-phase variables below as blank examples; none of them are consumed by the Phase 1 app.

# Phase 1 — web app, canonical auth URL, and public Supabase client configuration
# NODE_ENV is normally set by the npm script (next dev/next build); it is listed here only because the
# canonical-URL validator treats 'development' as the single environment allowed to omit APP_URL.
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=SUHBAT AI
# Canonical origin for email confirmation/callback redirects. Production and staging require explicit HTTPS.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Future Phase 3+ — worker-only Supabase credentials; do not place these in the web app environment.
# Service-role credentials bypass RLS and must never be used for ordinary user requests.
SUPABASE_SERVICE_ROLE_KEY=
# Optional narrowly privileged direct PostgreSQL connection for an isolated worker only.
SUPABASE_DB_URL=

# Future Phase 3 — private object-storage adapter; not used by Phase 1.
STORAGE_PROVIDER=local
LOCAL_OBJECT_STORAGE_ROOT=.local/object-storage
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# Future Phase 3 — durable worker tuning; validate against production workloads/limits before enabling.
WORKER_CONCURRENCY=4
PROCESSING_MAX_ATTEMPTS=5
PROCESSING_LEASE_SECONDS=300

# Future Phase 4 — transcription provider secrets/configuration; server/worker only.
TRANSCRIPTION_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_TRANSCRIPTION_MODEL=

# Future Phase 5 — analysis provider secrets/configuration; server/worker only.
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=

# Future Phase 7 — embedding model configuration; server/worker only.
OPENAI_EMBEDDING_MODEL=
OPENAI_EMBEDDING_DIMENSIONS=1536

# Future operations — structured logging and optional telemetry; not read by Phase 1 code.
LOG_LEVEL=info
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
