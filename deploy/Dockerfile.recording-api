# syntax=docker/dockerfile:1
# Recording API — PRIVATE. Role: recording-api.
# Holds SUPABASE_DB_URL and the R2 credentials. Holds no processing provider key.

ARG NODE_VERSION=22.23.3
FROM node:${NODE_VERSION}-slim AS base
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

FROM base AS build
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential node-gyp pkg-config python-is-python3 && \
    rm -rf /var/lib/apt/lists/*
COPY . .
RUN npm ci --include=dev
# Only the database and contracts packages are needed; the web app is not built here.
RUN npm prune --omit=dev

FROM base AS runner
ENV NODE_ENV=production
ENV SUHBAT_RUNTIME_ROLE=recording-api
ENV PORT=8080
ENV HOST=0.0.0.0
RUN npm i -g tsx@4.23.15
COPY --from=build /app /app

# No EXPOSE: the service is reachable only over the Fly private network.
CMD ["tsx", "apps/recording-api/src/index.ts"]
