# syntax=docker/dockerfile:1
# Worker — PRIVATE. Role: worker.
# Holds SUPABASE_DB_URL and every provider credential. Exposes no port.

ARG NODE_VERSION=22.23.3
FROM node:${NODE_VERSION}-slim AS base
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

FROM base AS build
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential node-gyp pkg-config python-is-python3 && \
    rm -rf /var/lib/apt/lists/*
COPY . .
RUN npm ci --include=dev
# Dev dependencies are pruned from the runtime image; `tsx` is reinstalled globally below because it
# is the process runner, not a build tool.
RUN npm prune --omit=dev

FROM base AS runner
ENV NODE_ENV=production
ENV SUHBAT_RUNTIME_ROLE=worker
RUN npm i -g tsx@4.23.15
COPY --from=build /app /app

# No EXPOSE and no CMD serving HTTP. The worker polls for jobs.
CMD ["tsx", "packages/database/src/worker-daemon.ts"]
