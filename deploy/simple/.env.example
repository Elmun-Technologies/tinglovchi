# Your address, e.g. suhbat-agentlik.duckdns.org (free at duckdns.org). Point it at the server's IP first.
DOMAIN=

# The password your team types once per device. Long and secret.
SUHBAT_ACCESS_CODE=

# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# claude-haiku-5-5 (cheapest, default) | claude-sonnet-5-5 | claude-opus-5-5 (deepest)
ANTHROPIC_MODEL=claude-haiku-5-5

# Speech-to-text: assemblyai (new accounts get $50 free credit) or elevenlabs
TRANSCRIPTION_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=
# ELEVENLABS_API_KEY=

# Optional Telegram bot (@BotFather -> /newbot). After `docker compose up`, run ./telegram-webhook.sh once.
TELEGRAM_BOT_TOKEN=
# Optional: a group chat id that also receives results of recordings made on the website.
TELEGRAM_TEAM_CHAT_ID=
